<?xml version="1.0" encoding="utf-8"?>
<!--
  X4 Co-op (prototype) - Mission Director side.

  ui/x4_coop.lua does the maths and the networking. This script only does what Lua cannot:
    * spawn / despawn the proxy ship that stands in for the other player
    * warp the proxy (sector changes, and every snap of the "md" movement backend)
    * set the proxy's velocity (the "md" movement backend)
    * report the engine's rotation basis vectors (the rotation-convention probe)

  Lua -> MD : AddUITriggeredEvent("x4coop", <command>, {args...})   => event.param3 is the args list
  MD  -> Lua: raise_lua_event 'x4coop.<name>'; structured replies go through player.entity.$x4coop_* blackboard vars

  Safeguards: every proxy we create is tracked in Root.$AllProxies and destroyed on game start/load,
  when Lua (re)starts, and before every new spawn, so a proxy cannot outlive the session that owns it.
  Units: Lua sends plain numbers. MD takes them as metres and metres per second directly, but angles
  must be typed, so radians are multiplied by 57.29577951308232deg (one radian as an angle).
-->
<mdscript name="X4_Coop" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <cue name="Root" version="1">
      <actions>
        <set_value name="$DebugChance" exact="100"/>
        <set_value name="$Proxy" exact="null"/>
        <set_value name="$AllProxies" exact="[]"/>
        <set_value name="$FallbackMacro" exact="macro.ship_arg_s_fighter_01_a_macro"/>
      </actions>
      <cues>

        <!-- Game started or save loaded: clear leftovers, then tell Lua that MD is listening. -->
        <cue name="OnGameStart" instantiate="true">
          <conditions>
            <check_any>
              <event_game_started/>
              <event_game_loaded/>
            </check_any>
          </conditions>
          <actions>
            <include_actions ref="DestroyProxies"/>
            <include_actions ref="DestroyMirrors"/>
            <raise_lua_event name="'x4coop.md_ready'"/>
          </actions>
        </cue>

        <!-- Lua (re)started, e.g. after /reloadui. Its state is gone, so drop the proxy and re-handshake. -->
        <cue name="OnLuaReady" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'x4coop'" control="'lua_ready'"/>
          </conditions>
          <actions>
            <include_actions ref="DestroyProxies"/>
            <include_actions ref="DestroyMirrors"/>
            <raise_lua_event name="'x4coop.md_ready'"/>
          </actions>
        </cue>

        <!--
          param3: [sector_macro, ship_macro, x, y, z, yaw, pitch, roll, label, idcode, adopt, pilot]
          (sector space, metres, radians). adopt=1 (shared world): if a player-owned ship with the partner's ID code
          exists here and is free, it becomes the proxy instead of a spawned copy, so their ship isn't duplicated.
          pilot=1: a spawned copy gets a drone pilot so it can run x4coop.proxy.fire.
        -->
        <cue name="OnSpawn" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'x4coop'" control="'spawn'"/>
          </conditions>
          <actions>
            <set_value name="$Args" exact="event.param3"/>
            <include_actions ref="DestroyProxies"/>
            <find_sector name="$Sector" macro="@macro.{$Args.{1}}"/>
            <do_if value="not $Sector">
              <debug_text text="'x4coop: cannot spawn proxy, unknown sector macro %s'.[$Args.{1}]" filter="error"/>
              <raise_lua_event name="'x4coop.spawn_failed'" param="'unknown sector ' + $Args.{1}"/>
            </do_if>
            <do_else>
              <set_value name="$Macro" exact="@macro.{$Args.{2}}"/>
              <do_if value="not @$Macro.isclass.ship">
                <debug_text text="'x4coop: ship macro %s not available here, using fallback'.[$Args.{2}]" chance="$DebugChance"/>
                <set_value name="$Macro" exact="Root.$FallbackMacro"/>
              </do_if>
              <set_value name="$Ship" exact="null"/>
              <do_if value="@$Args.{11} == 1 and @$Args.{10} != ''">
                <find_ship name="$Candidates" space="player.galaxy" macro="$Macro" multiple="true"/>
                <do_for_each name="$Candidate" in="$Candidates">
                  <do_if value="not $Ship and $Candidate.idcode == $Args.{10} and $Candidate.isplayerowned and $Candidate != player.occupiedship">
                    <set_value name="$Ship" exact="$Candidate"/>
                  </do_if>
                </do_for_each>
              </do_if>
              <do_if value="$Ship">
                <!-- Adopt the partner's own ship: stop whatever it was doing and bring it to where they are. -->
                <append_to_list name="Root.$Adopted" exact="$Ship"/>
                <set_value name="Root.$Proxy" exact="$Ship"/>
                <cancel_all_orders object="$Ship"/>
                <set_object_min_hull object="$Ship" exact="100"/>
                <warp object="$Ship" sector="$Sector">
                  <position x="$Args.{3}" y="$Args.{4}" z="$Args.{5}"/>
                  <rotation yaw="$Args.{6} * 57.29577951308232deg" pitch="$Args.{7} * 57.29577951308232deg" roll="$Args.{8} * 57.29577951308232deg"/>
                </warp>
                <debug_text text="'x4coop: adopted %s (%s) as the partner proxy in %s'.[$Ship.idcode, $Ship.knownname, $Sector.knownname]" chance="$DebugChance"/>
                <raise_lua_event name="'x4coop.proxy_spawned'" param="$Ship"/>
              </do_if>
              <do_else>
                <do_if value="@$Args.{12} == 1">
                  <create_ship name="$Ship" macro="$Macro" sector="$Sector">
                    <owner exact="faction.player" overridenpc="true"/>
                    <pilot><select race="race.drone" tags="tag.aipilot"/></pilot>
                    <loadout>
                      <level exact="0.5"/>
                    </loadout>
                    <position x="$Args.{3}" y="$Args.{4}" z="$Args.{5}"/>
                    <rotation yaw="$Args.{6} * 57.29577951308232deg" pitch="$Args.{7} * 57.29577951308232deg" roll="$Args.{8} * 57.29577951308232deg"/>
                  </create_ship>
                </do_if>
                <do_else>
                  <create_ship name="$Ship" macro="$Macro" sector="$Sector">
                    <owner exact="faction.player" overridenpc="true"/>
                    <pilot actor="null"/>
                    <loadout>
                      <level exact="0.5"/>
                    </loadout>
                    <position x="$Args.{3}" y="$Args.{4}" z="$Args.{5}"/>
                    <rotation yaw="$Args.{6} * 57.29577951308232deg" pitch="$Args.{7} * 57.29577951308232deg" roll="$Args.{8} * 57.29577951308232deg"/>
                  </create_ship>
                </do_else>
                <do_if value="@$Ship.isoperational">
                  <append_to_list name="Root.$AllProxies" exact="$Ship"/>
                  <set_value name="Root.$Proxy" exact="$Ship"/>
                  <!-- The real ship lives in the partner's universe; this one must not die, be boarded or be repaired into something else. -->
                  <set_object_min_hull object="$Ship" exact="100"/>
                  <set_object_capturable object="$Ship" capturable="false"/>
                  <set_object_name object="$Ship" name="'[Co-op] ' + $Args.{9}"/>
                  <debug_text text="'x4coop: spawned proxy %s (%s) in %s'.[$Ship, $Macro.id, $Sector.knownname]" chance="$DebugChance"/>
                  <raise_lua_event name="'x4coop.proxy_spawned'" param="$Ship"/>
                </do_if>
                <do_else>
                  <debug_text text="'x4coop: create_ship failed for %s in %s'.[$Macro, $Sector.knownname]" filter="error"/>
                  <raise_lua_event name="'x4coop.spawn_failed'" param="'create_ship failed'"/>
                </do_else>
              </do_else>
            </do_else>
          </actions>
        </cue>

        <cue name="OnDespawn" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'x4coop'" control="'despawn'"/>
          </conditions>
          <actions>
            <include_actions ref="DestroyProxies"/>
            <raise_lua_event name="'x4coop.proxy_despawned'"/>
          </actions>
        </cue>

        <!-- Move the proxy into another sector. param3: [sector_macro, x, y, z, yaw, pitch, roll] -->
        <cue name="OnWarp" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'x4coop'" control="'warp'"/>
            <check_value value="@Root.$Proxy.isoperational"/>
          </conditions>
          <actions>
            <set_value name="$Args" exact="event.param3"/>
            <find_sector name="$Sector" macro="@macro.{$Args.{1}}"/>
            <do_if value="not $Sector">
              <debug_text text="'x4coop: cannot warp proxy, unknown sector macro %s'.[$Args.{1}]" filter="error"/>
              <raise_lua_event name="'x4coop.spawn_failed'" param="'unknown sector ' + $Args.{1}"/>
            </do_if>
            <do_else>
              <warp object="Root.$Proxy" sector="$Sector">
                <position x="$Args.{2}" y="$Args.{3}" z="$Args.{4}"/>
                <rotation yaw="$Args.{5} * 57.29577951308232deg" pitch="$Args.{6} * 57.29577951308232deg" roll="$Args.{7} * 57.29577951308232deg"/>
              </warp>
              <raise_lua_event name="'x4coop.warped'" param="Root.$Proxy"/>
            </do_else>
          </actions>
        </cue>

        <!--
          "md" movement backend, used when Lua cannot place the proxy itself.
          param3: [x, y, z, yaw, pitch, roll, vx, vy, vz, snap]   (sector space; velocity in m/s, world axes)
          A snap teleports to the exact pose. Between snaps the engine coasts the proxy at the commanded velocity.
        -->
        <cue name="OnMove" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'x4coop'" control="'move'"/>
            <check_value value="@Root.$Proxy.isoperational"/>
          </conditions>
          <actions>
            <set_value name="$Args" exact="event.param3"/>
            <do_if value="$Args.{10} == 1">
              <warp object="Root.$Proxy" sector="Root.$Proxy.sector">
                <position x="$Args.{1}" y="$Args.{2}" z="$Args.{3}"/>
                <rotation yaw="$Args.{4} * 57.29577951308232deg" pitch="$Args.{5} * 57.29577951308232deg" roll="$Args.{6} * 57.29577951308232deg"/>
              </warp>
            </do_if>
            <set_object_velocity object="Root.$Proxy" constantvel="true">
              <linear x="$Args.{7}" y="$Args.{8}" z="$Args.{9}"/>
            </set_object_velocity>
          </actions>
        </cue>

        <!--
          engine_fx experiment: give the proxy (moved every frame by Lua) matching physics velocity, so the
          engine treats it as moving and it keeps drifting through frames without a Lua update.
          param3: [vx, vy, vz] in m/s, sector axes
        -->
        <cue name="OnVelocity" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'x4coop'" control="'velocity'"/>
            <check_value value="@Root.$Proxy.isoperational"/>
          </conditions>
          <actions>
            <set_object_velocity object="Root.$Proxy" constantvel="true">
              <linear x="event.param3.{1}" y="event.param3.{2}" z="event.param3.{3}"/>
            </set_object_velocity>
          </actions>
        </cue>

        <!--
          Rotation-convention probe. Lua knows yaw/pitch/roll but not which axis order and signs the engine uses;
          the engine's own basis vectors for the player's ship settle it.
          Reply (player.entity.$x4coop_probe): [yaw, pitch, roll, fx, fy, fz, rx, ry, rz, ux, uy, uz] in sector space.
        -->
        <cue name="OnProbe" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'x4coop'" control="'probe'"/>
          </conditions>
          <actions>
            <set_value name="$Ship" exact="player.occupiedship"/>
            <do_if value="@$Ship.isoperational and $Ship.sector">
              <set_value name="$Rot" exact="$Ship.relativerotation.{$Ship.sector}"/>
              <set_value name="player.entity.$x4coop_probe" exact="[
                $Rot.yaw, $Rot.pitch, $Rot.roll,
                $Rot.forward.x, $Rot.forward.y, $Rot.forward.z,
                $Rot.right.x, $Rot.right.y, $Rot.right.z,
                $Rot.up.x, $Rot.up.y, $Rot.up.z]"/>
              <raise_lua_event name="'x4coop.probe_result'"/>
            </do_if>
          </actions>
        </cue>

        <!--
          /x4coop join: warp the player's ship beside the partner's proxy, facing the same way.
          Only from the pilot seat, undocked, in normal space. Answers with a notification either way.
        -->
        <cue name="OnJoinPartner" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'x4coop'" control="'join'"/>
          </conditions>
          <actions>
            <set_value name="$Ship" exact="player.occupiedship"/>
            <do_if value="not @Root.$Proxy.isoperational">
              <show_notification text="'Co-op: your partner is not visible yet'" timeout="6s"/>
            </do_if>
            <do_elseif value="not @$Ship.isoperational or @$Ship.dock or not @$Ship.parent.isclass.space">
              <show_notification text="'Co-op: sit in the pilot seat of an undocked ship to join your partner'" timeout="6s"/>
            </do_elseif>
            <do_else>
              <set_value name="$Gap" exact="Root.$Proxy.size + $Ship.size"/>
              <create_position name="$Pos" object="Root.$Proxy" x="$Gap" space="Root.$Proxy.sector"/>
              <warp object="$Ship" sector="Root.$Proxy.sector">
                <safepos value="$Pos"/>
                <rotation value="Root.$Proxy.relativerotation.{Root.$Proxy.sector}"/>
              </warp>
              <debug_text text="'x4coop: joined partner in %s'.[Root.$Proxy.sector.knownname]" chance="$DebugChance"/>
              <show_notification text="'Co-op: joined your partner in ' + Root.$Proxy.sector.knownname" timeout="6s"/>
            </do_else>
          </actions>
        </cue>

        <!-- param3: text to show the player -->
        <cue name="OnNotify" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'x4coop'" control="'notify'"/>
          </conditions>
          <actions>
            <show_notification text="'Co-op: ' + event.param3" timeout="6s"/>
          </actions>
        </cue>

        <!--
          Shared world (both players loaded the same save; Lua only forwards these once the worlds are linked).
          The local player's kills and hits are reported by ship ID code; the partner's are applied to the same
          ship here. Damage merges as "lowest hull wins", so both players' hits add up.
        -->
        <cue name="OnPlayerKill" instantiate="true">
          <conditions>
            <event_player_killed_object/>
          </conditions>
          <actions>
            <set_value name="$Obj" exact="event.param"/>
            <do_if value="@$Obj.isclass.ship and @$Obj.sector and not Root.$AllProxies.indexof.{$Obj} and not @Root.$Adopted.indexof.{$Obj}">
              <raise_lua_event name="'x4coop.world'" param="'K|' + $Obj.idcode + '|' + $Obj.macro.id + '|' + $Obj.sector.macro.id"/>
            </do_if>
          </actions>
        </cue>

        <cue name="OnPlayerHit" instantiate="true">
          <conditions>
            <event_player_attacked_object/>
          </conditions>
          <actions>
            <set_value name="$Obj" exact="event.param"/>
            <do_if value="@$Obj.isclass.ship and @$Obj.isoperational and @$Obj.sector and not Root.$AllProxies.indexof.{$Obj} and not @Root.$Adopted.indexof.{$Obj}">
              <raise_lua_event name="'x4coop.world'" param="'D|%s|%s|%s|%s'.[$Obj.idcode, $Obj.macro.id, $Obj.sector.macro.id, $Obj.hullpercentage]"/>
            </do_if>
          </actions>
        </cue>

        <!-- param3: [idcode, ship_macro, sector_macro] -->
        <cue name="OnWorldKill" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'x4coop'" control="'world_kill'"/>
          </conditions>
          <actions>
            <set_value name="$Args" exact="event.param3"/>
            <include_actions ref="FindWorldShip"/>
            <do_if value="$Target">
              <debug_text text="'x4coop: partner killed %s %s'.[$Target.idcode, $Target.knownname]" chance="$DebugChance"/>
              <destroy_object object="$Target" explosion="true"/>
            </do_if>
          </actions>
        </cue>

        <!-- param3: [idcode, ship_macro, sector_macro, hull_percentage] -->
        <cue name="OnWorldHull" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'x4coop'" control="'world_hull'"/>
          </conditions>
          <actions>
            <set_value name="$Args" exact="event.param3"/>
            <include_actions ref="FindWorldShip"/>
            <do_if value="$Target and $Target.hullpercentage gt $Args.{4}">
              <set_object_hull object="$Target" exact="$Args.{4}"/>
            </do_if>
          </actions>
        </cue>

        <!--
          NPC bubble (shared world): while Lua sets a radius, list the ships near the player every second, nearest
          first, without mass traffic, drones, docked ships or proxies. Reply: player.entity.$x4coop_bubble, then
          raise 'x4coop.bubble'. param3: [radius in metres, 0 = off]
        -->
        <cue name="OnBubbleConfig" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'x4coop'" control="'bubble'"/>
          </conditions>
          <actions>
            <set_value name="Root.$BubbleRadius" exact="event.param3.{1}"/>
          </actions>
        </cue>

        <cue name="BubbleScan" instantiate="true" checkinterval="1s">
          <conditions>
            <check_value value="@Root.$BubbleRadius gt 0 and @player.occupiedship.sector"/>
          </conditions>
          <actions>
            <set_value name="$Center" exact="player.occupiedship"/>
            <find_ship name="$Found" space="$Center.sector" multiple="true" sortbydistanceto="$Center" sortlimit="60">
              <match_distance object="$Center" max="Root.$BubbleRadius"/>
            </find_ship>
            <set_value name="$Bubble" exact="[]"/>
            <do_for_each name="$Candidate" in="$Found">
              <do_if value="$Bubble.count lt 40 and $Candidate != $Center and $Candidate.isoperational and not $Candidate.ismasstraffic and not $Candidate.isunit and not @$Candidate.dock and $Candidate.parent.isclass.space and not Root.$AllProxies.indexof.{$Candidate} and not @Root.$Adopted.indexof.{$Candidate} and not @Root.$Mirrors.indexof.{$Candidate}">
                <append_to_list name="$Bubble" exact="$Candidate"/>
              </do_if>
            </do_for_each>
            <set_value name="player.entity.$x4coop_bubble" exact="$Bubble"/>
            <raise_lua_event name="'x4coop.bubble'"/>
          </actions>
        </cue>

        <!--
          Stand-in for a ship only the host has (NPC bubble, joiner side). Lua moves it like the host's other ships.
          param3: [host_idcode, ship_macro, owner_faction_id, sector_macro, x, y, z, yaw, pitch, roll]
          Reply: player.entity.$x4coop_mirror = [host_idcode, ship], then raise 'x4coop.npc_mirror'.
        -->
        <cue name="OnNpcMirror" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'x4coop'" control="'npc_mirror'"/>
          </conditions>
          <actions>
            <set_value name="$Args" exact="event.param3"/>
            <do_if value="not Root.$Mirrors?">
              <set_value name="Root.$Mirrors" exact="[]"/>
            </do_if>
            <find_sector name="$Sector" macro="@macro.{$Args.{4}}"/>
            <set_value name="$Macro" exact="@macro.{$Args.{2}}"/>
            <set_value name="$Owner" exact="@faction.{$Args.{3}}"/>
            <do_if value="$Sector and @$Macro.isclass.ship and $Owner">
              <create_ship name="$Ship" macro="$Macro" sector="$Sector">
                <owner exact="$Owner" overridenpc="true"/>
                <pilot>
                  <select race="race.drone" tags="tag.aipilot"/>
                </pilot>
                <loadout>
                  <level exact="0.5"/>
                </loadout>
                <position x="$Args.{5}" y="$Args.{6}" z="$Args.{7}"/>
                <rotation yaw="$Args.{8} * 57.29577951308232deg" pitch="$Args.{9} * 57.29577951308232deg" roll="$Args.{10} * 57.29577951308232deg"/>
              </create_ship>
              <do_if value="@$Ship.isoperational">
                <append_to_list name="Root.$Mirrors" exact="$Ship"/>
                <set_value name="player.entity.$x4coop_mirror" exact="[$Args.{1}, $Ship]"/>
                <raise_lua_event name="'x4coop.npc_mirror'"/>
              </do_if>
            </do_if>
          </actions>
        </cue>

        <cue name="OnNpcClear" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'x4coop'" control="'npc_clear'"/>
          </conditions>
          <actions>
            <include_actions ref="DestroyMirrors"/>
          </actions>
        </cue>

        <!--
          Direct actions on one of the joiner's ships, handed over by Lua (param3.{1} = the ship). Never the player's
          ship or a proxy; obj_remove (quiet, used for ships the host doesn't have) never touches player-owned ships.
        -->
        <cue name="OnObjKill" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'x4coop'" control="'obj_kill'"/>
          </conditions>
          <actions>
            <set_value name="$Obj" exact="event.param3.{1}"/>
            <include_actions ref="CheckObj"/>
            <do_if value="$ObjOk">
              <destroy_object object="$Obj" explosion="true"/>
            </do_if>
          </actions>
        </cue>

        <cue name="OnObjRemove" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'x4coop'" control="'obj_remove'"/>
          </conditions>
          <actions>
            <set_value name="$Obj" exact="event.param3.{1}"/>
            <include_actions ref="CheckObj"/>
            <do_if value="$ObjOk and (not $Obj.isplayerowned or @Root.$Mirrors.indexof.{$Obj})">
              <do_if value="@Root.$Mirrors.indexof.{$Obj}">
                <remove_from_list name="Root.$Mirrors" exact="$Obj"/>
              </do_if>
              <destroy_object object="$Obj" explosion="false"/>
            </do_if>
          </actions>
        </cue>

        <cue name="OnObjHull" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'x4coop'" control="'obj_hull'"/>
          </conditions>
          <actions>
            <set_value name="$Obj" exact="event.param3.{1}"/>
            <include_actions ref="CheckObj"/>
            <do_if value="$ObjOk and $Obj.hullpercentage gt event.param3.{2}">
              <set_object_hull object="$Obj" exact="event.param3.{2}"/>
            </do_if>
          </actions>
        </cue>

        <cue name="OnObjFire" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'x4coop'" control="'obj_fire'"/>
            <check_value value="@Root.$Proxy.pilot.exists"/>
          </conditions>
          <actions>
            <set_value name="$Obj" exact="event.param3.{1}"/>
            <include_actions ref="CheckObj"/>
            <do_if value="$ObjOk">
              <start_script name="'x4coop.proxy.fire'" object="Root.$Proxy.pilot">
                <param name="target" value="$Obj"/>
                <param name="duration" value="1.2s"/>
              </start_script>
            </do_if>
          </actions>
        </cue>

        <!-- In: $Obj. Out: $ObjOk, true for an operational ship that is not the player's and not a proxy. -->
        <library name="CheckObj">
          <actions>
            <set_value name="$ObjOk" exact="@$Obj.isoperational and $Obj.isclass.ship and $Obj != player.occupiedship and not Root.$AllProxies.indexof.{$Obj} and not @Root.$Adopted.indexof.{$Obj}"/>
          </actions>
        </library>

        <library name="DestroyMirrors">
          <actions>
            <do_if value="Root.$Mirrors?">
              <do_for_each name="$OldMirror" in="Root.$Mirrors">
                <do_if value="$OldMirror.exists">
                  <destroy_object object="$OldMirror" explosion="false"/>
                </do_if>
              </do_for_each>
            </do_if>
            <set_value name="Root.$Mirrors" exact="[]"/>
          </actions>
        </library>

        <!-- The partner is hitting a ship: their proxy fires at the same ship here. param3: [idcode, ship_macro, sector_macro] -->
        <cue name="OnFire" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'x4coop'" control="'fire'"/>
            <check_value value="@Root.$Proxy.pilot.exists"/>
          </conditions>
          <actions>
            <set_value name="$Args" exact="event.param3"/>
            <include_actions ref="FindWorldShip"/>
            <do_if value="$Target">
              <start_script name="'x4coop.proxy.fire'" object="Root.$Proxy.pilot">
                <param name="target" value="$Target"/>
                <param name="duration" value="1.2s"/>
              </start_script>
            </do_if>
          </actions>
        </cue>

        <!-- In: $Args = [idcode, ship_macro, sector_macro, ...]. Out: $Target, the matching ship or null. Never the player's ship or a proxy. -->
        <library name="FindWorldShip">
          <actions>
            <set_value name="$Target" exact="null"/>
            <find_sector name="$Sector" macro="@macro.{$Args.{3}}"/>
            <set_value name="$Macro" exact="@macro.{$Args.{2}}"/>
            <do_if value="$Sector and $Macro">
              <find_ship name="$Candidates" space="$Sector" macro="$Macro" multiple="true"/>
              <do_for_each name="$Candidate" in="$Candidates">
                <do_if value="not $Target and $Candidate.idcode == $Args.{1} and $Candidate != player.occupiedship and not Root.$AllProxies.indexof.{$Candidate} and not @Root.$Adopted.indexof.{$Candidate}">
                  <set_value name="$Target" exact="$Candidate"/>
                </do_if>
              </do_for_each>
            </do_if>
          </actions>
        </library>

        <library name="DestroyProxies">
          <actions>
            <!-- Adopted ships are the partner's real ship in this world: hand them back, never destroy them. -->
            <do_if value="not Root.$Adopted?">
              <set_value name="Root.$Adopted" exact="[]"/>
            </do_if>
            <do_for_each name="$OldProxy" in="Root.$Adopted">
              <do_if value="$OldProxy.exists">
                <set_object_min_hull object="$OldProxy" exact="0"/>
              </do_if>
            </do_for_each>
            <set_value name="Root.$Adopted" exact="[]"/>
            <do_for_each name="$OldProxy" in="Root.$AllProxies">
              <do_if value="$OldProxy.exists">
                <destroy_object object="$OldProxy" explosion="false"/>
              </do_if>
            </do_for_each>
            <set_value name="Root.$AllProxies" exact="[]"/>
            <set_value name="Root.$Proxy" exact="null"/>
          </actions>
        </library>

      </cues>
    </cue>
  </cues>
</mdscript>
